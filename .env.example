# Copy to .env for local use. Never commit real secrets.
APP_ENV=development
APP_VERSION=4.0.0
LOG_LEVEL=INFO
LOG_JSON=true
REQUIRE_API_KEY=false
API_KEY=replace-with-at-least-16-random-characters
CORS_ORIGINS=http://localhost:8501
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
METRICS_ENABLED=true
MAX_REQUEST_BODY_BYTES=1048576

# Enable these for the optional PostgreSQL warehouse.
POSTGRES_DB=project_rising
POSTGRES_USER=rising_user
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg2://rising_user:replace-with-a-strong-password@postgres:5432/project_rising
DATABASE_REQUIRED=false
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_MAX_RETRIES=3

